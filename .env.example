# ── Emporia Vue Gen 2 (required) ─────────────────────────────────────────────
EMPORIA_EMAIL=you@example.com
EMPORIA_PASSWORD=yourpassword

# ── APSystems Solar (optional — pick one) ────────────────────────────────────
# Local ECU on your LAN (preferred — faster, no auth required)
APSYSTEMS_ECU_IP=192.168.1.100

# OR cloud EMA API (needs developer account at developer.apsystemsema.com)
# APSYSTEMS_ECU_ID=your_ecu_serial_number
# APSYSTEMS_API_KEY=your_api_key

# ── Energy cost ───────────────────────────────────────────────────────────────
RATE_PER_KWH=0.13

# ── Alerting via ntfy.sh ──────────────────────────────────────────────────────
# Leave NTFY_TOPIC blank to disable alerts
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# kW threshold that triggers an alert (0 = disabled)
ALERT_KW_THRESHOLD=0

# ── Polling ───────────────────────────────────────────────────────────────────
# How often to record circuit snapshots and refresh daily totals (ms)
# POLL_INTERVAL_MS=300000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
